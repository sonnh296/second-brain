{
  "name": "second-brain",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file=.env.local workers/ingestion-worker.ts",
    "retry-pending": "DOTENV_CONFIG_PATH=.env.local tsx scripts/retry-pending.ts",
    "retry-failed": "DOTENV_CONFIG_PATH=.env.local tsx scripts/retry-failed-jobs.ts",
    "create-admin": "DOTENV_CONFIG_PATH=.env.local tsx scripts/create-admin.ts",
    "reindex-all": "DOTENV_CONFIG_PATH=.env.local tsx scripts/reindex-all.ts",
    "eval-retrieval": "DOTENV_CONFIG_PATH=.env.local tsx scripts/eval-retrieval.ts",
    "cleanup-orphans": "DOTENV_CONFIG_PATH=.env.local tsx scripts/cleanup-orphans.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
